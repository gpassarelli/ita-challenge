{
  "name": "allya-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write --no-error-on-unmatched-pattern src tests scripts *.ts *.mts *.mjs *.json README.md docs/*.md",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src tests scripts *.ts *.mts *.mjs *.json README.md docs/*.md",
    "generate:schema": "node --experimental-strip-types scripts/generate-views.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.83",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-table": "8.21.3",
    "ai": "7.0.127",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "workflow": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    },
    "@workflow/nest": {
      "@swc/cli": "0.8.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
